{
  "name": "posthtml",
  "version": "0.16.7",
  "description": "HTML/XML processor",
  "keywords": [
    "html",
    "xml",
    "postproccessor",
    "parser",
    "transform",
    "transformations",
    "manipulation",
    "preprocessor",
    "processor"
  ],
  "main": "lib",
  "types": "types/posthtml.d.ts",
  "files": [
    "types",
    "lib"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "posthtml-parser": "^0.13.0",
    "posthtml-render": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "c8 mocha",
    "test:package": "node --test test/package.test.cjs",
    "test:packed": "node test/packed.cjs",
    "typecheck": "tsc --noEmit -p test/types/tsconfig.json",
    "typecheck:minimum": "npm exec --yes --package=typescript@5.3.3 -- tsc --noEmit -p test/types/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run typecheck:minimum && npm test && npm run test:package",
    "prepublishOnly": "npm run check",
    "docs:api": "jsdoc2md lib/api.js > docs/api.md",
    "docs:core": "jsdoc2md lib/index.js > docs/core.md"
  },
  "author": "Ivan Voischev <voischev.ivan@ya.ru>",
  "contributors": [
    {
      "name": "Ivan Voischev",
      "email": "voischev.ivan@ya.ru"
    },
    {
      "name": "Ivan Demidov",
      "email": "scrum@list.ru"
    }
  ],
  "homepage": "https://github.com/posthtml/posthtml",
  "repository": "https://github.com/posthtml/posthtml.git",
  "bugs": "https://github.com/posthtml/posthtml/issues",
  "license": "MIT"
}
